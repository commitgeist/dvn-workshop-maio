{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "terraform-mcp": {
      "type": "local",
      "command": [
        "docker",
        "run",
        "-i",
        "--rm",
        "hashicorp/terraform-mcp-server:0.5.2"
      ]
    },
    "aws-mcp": {
      "type": "local",
      "command": [
        "uvx",
        "mcp-proxy-for-aws@latest",
        "https://aws-mcp.us-east-1.api.aws/mcp",
        "--metadata",
        "AWS_REGION=us-east-1"
      ]
    },
    "kubernetes-mcp": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@strowk/mcp-k8s"
      ]
    },
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp"
      ]
    }
  }
}
